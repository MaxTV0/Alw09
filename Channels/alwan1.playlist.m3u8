#!/usr/bin/env python3
"""
مولّد HLS Live ديناميكي
- يحدّث EXT-X-PROGRAM-DATE-TIME تلقائياً بالوقت الحقيقي
- ينقل MEDIA-SEQUENCE مع كل مقطع جديد
- نافذة متجددة (Sliding Window) بدل قائمة ثابتة
"""

import time
from datetime import datetime, timezone, timedelta
from pathlib import Path

# ============ الإعدادات ============
OUT_FILE        = Path("stream.m3u8")
SEG_DUR         = 10.0                    # مدة المقطع (ثواني)
WINDOW          = 6                       # عدد المقاطع في القائمة
TARGET_DURATION = 11                      # أقصى مدة مقرّبة لأعلى
CAN_SKIP_UNTIL  = 66                      # ثواني
START_OFFSET    = -22.0                   # سالب = من نهاية القائمة (لحافة البث)
UNIQUE_BASE     = 1791563373700074389     # أول رقم في سلسلة الأسماء
SEG_EXT         = "ts?type=event"


def iso(dt: datetime) -> str:
    """تنسيق ISO8601 مطابق لـ HLS."""
    return (dt.astimezone(timezone.utc)
              .strftime("%Y-%m-%dT%H:%M:%S.")
            + f"{dt.microsecond // 1000:03d}Z")


def build_playlist(media_sequence: int, epoch: datetime) -> str:
    """
    media_sequence : رقم أول مقطع في النافذة (يتغير ديناميكياً)
    epoch          : لحظة انطلاق البث (ثابتة عبر التشغيلات)
    """
    lines = [
        "#EXTM3U",
        "#EXT-X-VERSION:6",
        f"#EXT-X-TARGETDURATION:{TARGET_DURATION}",
        f"#EXT-X-SERVER-CONTROL:CAN-SKIP-UNTIL={CAN_SKIP_UNTIL},CAN-BLOCK-RELOAD=YES",
        f"#EXT-X-START:TIME-OFFSET={START_OFFSET:.2f}",
        "#EXT-X-INDEPENDENT-SEGMENTS",
        f"#EXT-X-MEDIA-SEQUENCE:{media_sequence}",
    ]

    for i in range(WINDOW):
        idx = media_sequence + i
        pdt = epoch + timedelta(seconds=SEG_DUR * idx)
        uid = UNIQUE_BASE + idx
        lines.append(f"#EXT-X-PROGRAM-DATE-TIME:{iso(pdt)}")
        lines.append(f"#EXTINF:{SEG_DUR:.3f},")
        lines.append(f"chunk_{uid}_{idx}_a.{SEG_EXT}")

    return "\n".join(lines) + "\n"


def main():
    # لحظة البداية - ثابتة طول التشغيل
    epoch = datetime.now(timezone.utc).replace(microsecond=0)
    seq   = 0

    print("▶ تشغيل المولّد الديناميكي… (Ctrl+C للإيقاف)")
    try:
        while True:
            OUT_FILE.write_text(build_playlist(seq, epoch), encoding="utf-8")
            print(f"[{iso(datetime.now(timezone.utc))}] "
                  f"media_sequence={seq}  |  نافذة: {seq}..{seq + WINDOW - 1}")
            seq += 1
            time.sleep(SEG_DUR)          # ننتظر وصول مقطع جديد
    except KeyboardInterrupt:
        print("\n⏹ تم الإيقاف.")


if __name__ == "__main__":
    main()
